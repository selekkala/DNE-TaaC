# RBB SRv6 non-secret profile template.
#
# `./scripts/run-rbb-srv6.sh --init` installs this as `.taac/rbb.env`. Replace
# the topology identities after initialization. Docker env-file syntax is plain
# KEY=value: do not add `export`, shell substitutions, or quotes around values.
# Credentials belong in `.taac/secrets.json`.

TAAC_OSS=1

# These names must match device_info.csv.
TAAC_RBB_R1_HOST=rbb-r1.lab.example
TAAC_RBB_R2_HOST=rbb-r2.lab.example
TAAC_RBB_R1_HARDWARE=GENERIC_FBOSS
TAAC_RBB_R2_HARDWARE=GENERIC_FBOSS

# Core address plan. These RFC 5737/RFC 3849 defaults are immediately runnable
# for fresh-image bootstrap in an isolated lab. For the preconfigured workflow,
# set them to the addresses already present on each selected core RIF. CORE0/
# CORE1 map by CSV port-channel order, never by fixed ports.
TAAC_RBB_R1_ROUTER_ID=192.0.2.1
TAAC_RBB_R2_ROUTER_ID=192.0.2.2
TAAC_RBB_R1_LOOPBACK_V6=2001:db8:0:1::1
TAAC_RBB_R2_LOOPBACK_V6=2001:db8:0:2::1
TAAC_RBB_R1_CORE0_V4=198.51.100.1/30
TAAC_RBB_R2_CORE0_V4=198.51.100.2/30
TAAC_RBB_R1_CORE0_V6=2001:db8:c0::/127
TAAC_RBB_R2_CORE0_V6=2001:db8:c0::1/127
TAAC_RBB_R1_CORE1_V4=198.51.100.5/30
TAAC_RBB_R2_CORE1_V4=198.51.100.6/30
TAAC_RBB_R1_CORE1_V6=2001:db8:c1::/127
TAAC_RBB_R2_CORE1_V6=2001:db8:c1::1/127
TAAC_RBB_R1_SRV6_SID_A=2001:db8:fe00:200::1:0/128
TAAC_RBB_R1_SRV6_SID_B=2001:db8:feff:200::1:0/128
TAAC_RBB_R2_SRV6_SID_A=2001:db8:fe00:200::2:0/128
TAAC_RBB_R2_SRV6_SID_B=2001:db8:feff:200::2:0/128

# Default RFC 3849 documentation-range SRv6 plan. When only the locator is
# changed, TAAC derives functions 27cc, 27d6, and 7fff inside the new locator.
TAAC_RBB_SRV6_LOCATOR=2001:db8:6::/48
# Uncomment only when the deployed uSID functions differ from those defaults.
# TAAC_RBB_SRV6_USID_HEAD=2001:db8:6:27cc::
# TAAC_RBB_SRV6_USID_MID=2001:db8:6:27d6::
# TAAC_RBB_SRV6_USID_TAIL=2001:db8:6:7fff::
# TAAC_RBB_SRV6_DECAP_SID=2001:db8:6:7fff::

# The base, tail-decap, and resilience suites require the TE_AGENT destination
# and the single R2 IXIA-advertised pool to match.
TAAC_RBB_IXIA_TAIL_PREFIX=2001:db8:beef::
TAAC_RBB_IXIA_TAIL_PREFIX_LEN=64
TAAC_RBB_IXIA_TAIL_PREFIX_COUNT=1
TAAC_RBB_TAIL_PREFIX=2001:db8:beef::/64

# Isolated destination owned temporarily by the device-only named-NHG suite.
# It must not overlap the active tail service prefix or SRv6 locator.
TAAC_RBB_NAMED_NHG_TEST_PREFIX=2001:db8:ff00::/64

# The traffic-foundation suite also advertises a head-side pool. It permits
# both head and tail counts above 1 and validates that the complete ranges do
# not overlap. Other traffic suites must keep the tail count at 1.
TAAC_RBB_IXIA_HEAD_PREFIX=2001:db8:feed::
TAAC_RBB_IXIA_HEAD_PREFIX_LEN=64
TAAC_RBB_IXIA_HEAD_PREFIX_COUNT=1
# TAAC's normal IXIA advertisement allowlist remains enabled. Set this to 1
# only in an isolated lab whose explicitly owned prefix is outside that list.
TAAC_RBB_SKIP_ADVERTISED_PREFIXES_CHECK=0

# IXIA-facing IPv6 links. Physical card/port wiring stays in circuit_info.csv.
TAAC_RBB_IXIA_R1_EDGE_V6=2001:db8:a:3::2
TAAC_RBB_IXIA_R1_EDGE_GW_V6=2001:db8:a:3::1
TAAC_RBB_IXIA_R2_EDGE_V6=2001:db8:a:10::2
TAAC_RBB_IXIA_R2_EDGE_GW_V6=2001:db8:a:10::1
TAAC_RBB_IXIA_EDGE_MASK=64

# Default mode is read-mostly DUT validation without IXIA reservation or edge
# config mutation. Enable these deliberately for the full traffic test.
TAAC_RBB_INCLUDE_TRAFFIC=0
TAAC_RBB_EDGE_EBGP=0

# Required only after TAAC_RBB_INCLUDE_TRAFFIC is set to 1.
TAAC_RBB_IXIA_CHASSIS=rbb-ixia.lab.example
TAAC_IXIA_API_SERVER=192.0.2.10

# Optional traffic-foundation tuning. The bandwidth must match the selected
# IXIA-facing physical ports because it is used to calculate the expected rate.
# Values, in order: positive Gbps; 1..100%; at least 64 bytes; positive sample
# and drain seconds; 1..100% rate tolerance; 0..100% counter tolerance; and a
# positive absolute counter tolerance.
# TAAC_RBB_EDGE_BANDWIDTH_GBPS=400
# TAAC_RBB_TRAFFIC_LINE_RATE=10
# TAAC_RBB_TRAFFIC_FRAME_SIZE=512
# TAAC_RBB_TRAFFIC_SAMPLE_SECONDS=10
# TAAC_RBB_TRAFFIC_DRAIN_SECONDS=5
# TAAC_RBB_TRAFFIC_RATE_TOLERANCE_PCT=5
# TAAC_RBB_COUNTER_TOLERANCE_PCT=5
# TAAC_RBB_COUNTER_ABSOLUTE_TOLERANCE=256

# Optional core-ECMP controls for Phase 1 TC-02/03/08. The preferred and
# standby values are temporary Open/R adjacency-metric overrides; TAAC records
# pristine state first and clears only the overrides it owns. The per-path
# share is the minimum percentage of the IXIA traffic-item counter that every
# declared core path must carry during TC-08.
# TAAC_RBB_OPENR_PREFERRED_METRIC=10
# TAAC_RBB_OPENR_STANDBY_METRIC=1000
# TAAC_RBB_CORE_ECMP_MIN_PATH_SHARE_PCT=1

# Optional IPv4 companion for Phase 1 TC-11/12/15. Defaults use TAAC's
# 10.100.75.0/24 IXIA advertisement allowlist. TC-15 runs one IPv4 and one
# IPv6 item from each IXIA port concurrently, so 2 *
# TAAC_RBB_TRAFFIC_LINE_RATE must not exceed 100.
# TAAC_RBB_IXIA_R1_EDGE_V4=10.100.75.2
# TAAC_RBB_IXIA_R1_EDGE_GW_V4=10.100.75.1
# TAAC_RBB_IXIA_R2_EDGE_V4=10.100.75.6
# TAAC_RBB_IXIA_R2_EDGE_GW_V4=10.100.75.5
# TAAC_RBB_IXIA_EDGE_PREFIX_MASK_V4=30
# TAAC_RBB_IXIA_HEAD_PREFIX_V4=10.100.75.128
# TAAC_RBB_IXIA_HEAD_PREFIX_LEN_V4=32
# TAAC_RBB_IXIA_HEAD_PREFIX_COUNT_V4=1
# TAAC_RBB_IXIA_TAIL_PREFIX_V4=10.100.75.192
# TAAC_RBB_IXIA_TAIL_PREFIX_LEN_V4=32
# TAAC_RBB_IXIA_TAIL_PREFIX_COUNT_V4=1

# Optional resilience controls. TC-100 is partial and excluded from the public
# suite because the pinned zig-zag topology requires both core PCs. These
# path-selection settings are reserved for a custom configuration that
# explicitly opts into TC-100 after providing failover-capable MySID and
# underlay NHGs. Prefer the exact port-channel name from circuit_info.csv; the
# zero-based index is available for generated inventory.
# TAAC_RBB_RESILIENCE_CORE_PC_NAME=your-core-port-channel
# TAAC_RBB_RESILIENCE_CORE_PC_INDEX=0
# Minimum percentage of IXIA frames the selected TC-100 path must carry before
# TAAC is allowed to disable it. The default 1% rejects idle paths while
# permitting normal ECMP sharing and hash imbalance.
# TAAC_RBB_RESILIENCE_MIN_SELECTED_PATH_SHARE_PCT=1
# Resilience requires RESTPy/TaacIxia controller-counter resets to isolate each
# disruption and recovery window; OTG is rejected before DUT mutation. Loss is
# measured without a pass/fail SLA when this is unset. Set an explicit 0..100
# percentage only when the testbed has an approved convergence SLA. The value
# also applies to adapted TC-99, which independently requires observable loss.
# TAAC_RBB_RESILIENCE_MAX_LOSS_PCT=10

# Optional platform-specific SRv6 counter commands. The portable defaults are
# path counters; set these when the platform exposes dedicated SRv6 counters.
# TAAC_RBB_ENCAP_COUNTER_CMD=your encap counter command
# TAAC_RBB_ENCAP_COUNTER_REGEX=your encap counter regex
# TAAC_RBB_DECAP_COUNTER_CMD=your decap counter command
# TAAC_RBB_DECAP_COUNTER_REGEX=your decap counter regex
